# ==============================================================================
# Variables de entorno - Backend TTPS-E (Render + Supabase)
# Copiar a .env para desarrollo local o cargar en Render / GitHub Secrets.
# ==============================================================================

# --- Base de datos PostgreSQL (Supabase Session Pooler IPv4, puerto 5432) ---
# Ejemplo Supabase:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///:memory:
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300

# --- Seguridad y entorno ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-valor-aleatorio-seguro
TZ=America/Argentina/Buenos_Aires

# --- Almacenamiento persistente en Supabase Storage (opcional en local) ---
# Si SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY estan definidos, los archivos
# (PDFs, datos crudos y familiogramas) se guardan en Supabase Storage.
# Si se dejan vacios, se utiliza disco local (STORAGE_DIR o backend/app/storage).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=exoma-storage
# STORAGE_DIR=

# --- Notificaciones ---
BIOINFORMATICA_EQUIPO_EMAIL=
EMAIL_API_KEY=
# EMAIL_API_URL=

# --- APIs externas del proyecto ---
FAMILIOGRAMA_API_KEY=
SNOMED_API_KEY=
APIGEN_API_KEY=
CHATBOT_TOKEN=
CDSS_API_KEY=
CUPONES_API_KEY=
FEDEX_API_KEY=
OBRA_SOCIAL_API_KEY=
